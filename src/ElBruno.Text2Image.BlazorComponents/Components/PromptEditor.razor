<div class="t2i-prompt-editor">
    <div class="mb-3"><label class="form-label" for="@_promptId">Prompt</label><textarea id="@_promptId" class="form-control" rows="3" @bind="_prompt"></textarea></div>
    <div class="mb-3"><label class="form-label" for="@_negativeId">Negative prompt</label><textarea id="@_negativeId" class="form-control" rows="2" @bind="_negativePrompt"></textarea></div>
    <div class="row g-3">
        <div class="col-md-5"><label class="form-label">Guidance: @_guidanceScale.ToString("0.0")</label><input class="form-range" type="range" min="1" max="20" step="0.5" @bind="_guidanceScale" /></div>
        <div class="col-md-4"><label class="form-label">Steps: @_steps</label><input class="form-range" type="range" min="1" max="150" @bind="_steps" /></div>
        <div class="col-md-3"><label class="form-label">Seed</label><div class="input-group"><input class="form-control" type="number" @bind="_seed" placeholder="Random" /><button class="btn btn-outline-secondary" type="button" @onclick="RandomizeSeed">🎲</button></div></div>
    </div>
    <button class="btn btn-primary mt-3" disabled="@string.IsNullOrWhiteSpace(_prompt)" @onclick="Generate">Generate</button>
</div>

@code {
    [Parameter] public EventCallback<GenerationRequest> OnGenerate { get; set; }
    [Parameter] public double DefaultGuidanceScale { get; set; } = 7.5;
    [Parameter] public int DefaultSteps { get; set; } = 20;
    private string _prompt = string.Empty, _negativePrompt = string.Empty;
    private double _guidanceScale;
    private int _steps;
    private int? _seed;
    private readonly string _promptId = $"prompt-{Guid.NewGuid():N}";
    private readonly string _negativeId = $"negative-{Guid.NewGuid():N}";
    protected override void OnInitialized() { _guidanceScale = DefaultGuidanceScale; _steps = DefaultSteps; }
    private void RandomizeSeed() => _seed = Random.Shared.Next();
    private Task Generate() => OnGenerate.InvokeAsync(new GenerationRequest(_prompt, new ImageGenerationOptions
    {
        GuidanceScale = _guidanceScale,
        NumInferenceSteps = _steps,
        Seed = _seed
    }, _negativePrompt));
}
